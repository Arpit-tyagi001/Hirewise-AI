# HireWise AI - Backend Environment Template
# Duplicate this file to backend/.env and populate your secrets

# Groq Cloud API Key for AI resume bullet rewriting (https://console.groq.com)
GROQ_API_KEY=

# OpenAI API Key (Optional fallback if Groq is not configured)
OPENAI_API_KEY=

# Secret key used to sign JWT authentication tokens
JWT_SECRET_KEY=hirewise-ai-secret-jwt-key-2026-production

# Database connection URL (defaults to SQLite; or use PostgreSQL in production)
DATABASE_URL=sqlite:///hirewise.db
# DATABASE_URL=postgresql://user:password@localhost:5432/hirewise

# Allowed CORS Origins (comma-separated URLs)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Groq LLM model name (defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
