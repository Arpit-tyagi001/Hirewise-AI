# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Environment files — never bake secrets into the image
.env
.env.*

# Test files & fixtures
test_resumes/
test_*.py

# Database files — use a mounted volume or managed DB in production
*.db
*.sqlite
*.sqlite3

# Alembic local state (versions are included; local env state is not)
alembic/versions/__pycache__/

# Editor / OS artefacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Git
.git/
.gitignore

# CI configs — not needed inside the image
.github/

# uv / pip caches
.cache/
pip-cache/
